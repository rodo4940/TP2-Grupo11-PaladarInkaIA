# Rellenar y guardar fuera de Git; nunca subir datos reales.
PALADAR_DOMAIN=example.tu-dominio.pe
DATABASE_NAME=paladar_inka
DATABASE_USER=paladar_app
DATABASE_PASSWORD=GENERAR_CONTRASENA_ALEATORIA_LARGA
JWT_SECRET=GENERAR_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES
TOKEN_TTL_MINUTES=60
# Opcional: si se activa IA externa, configurar ambos SOLO en el servidor y
# registrar autorización para transmitir métricas agregadas del negocio.
# Sin estos valores, la IA continúa usando reglas explicables locales.
# AI_API_KEY=
# AI_MODEL=

# Bloqueo persistente por cuenta; complementar con rate limit WAF/IP en el edge.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
