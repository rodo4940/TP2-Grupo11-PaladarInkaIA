# Solo desarrollo local: no reutilizar contraseñas en producción
APP_NAME=Paladar Inka API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=paladar_inka
DATABASE_USER=paladar_user
DATABASE_PASSWORD=CHANGE_LOCAL_POSTGRES_PASSWORD
JWT_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
TOKEN_TTL_MINUTES=480
SEED_ADMIN_PASSWORD=CAMBIAR_PASSWORD_SEMILLA_ANTES_DE_EJECUTAR
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
# Asistente con modelo externo, completamente opcional y apagado por defecto.
# Si no se configura, /ai/ask usa reglas locales explicables.
# La clave NO debe exponerse en frontend, Git ni archivos de demo.
